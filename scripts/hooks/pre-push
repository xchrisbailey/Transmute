#!/usr/bin/env bash
# Lints before a push, since there's no hosted CI to catch it afterwards. Only the two fast
# checks; scripts/check.sh is the full gate. Turn it on once per clone:
#
#   git config core.hooksPath scripts/hooks
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

swiftlint lint --strict --quiet
swift format lint --strict --recursive Apps Packages
