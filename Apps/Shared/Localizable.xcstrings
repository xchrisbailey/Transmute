        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The crucible's empty. Brew a plan to begin."
          }
        }
      }
    },
    "voice.gold": {
      "comment": "voice. A new personal record, e.g. Gold. Squat 5RM, 115 kg.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gold. %1$@ %2$@, %3$@."
          }
        }
      }
    },
