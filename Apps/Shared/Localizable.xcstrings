        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Brewed on this %@ with Apple Intelligence"
          }
        }
      }
    },
    "voice.distilling": {
      "comment": "voice. Shown while the AI generates a plan, one week at a time.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Distilling week %lld…"
          }
        }
      }
    },
