            "value": "Rework this day"
          }
        }
      }
    },
    "voice.streak": {
      "comment": "voice. Training streak in weeks.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "The fire's lit · %lld week"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "The fire's lit · %lld weeks"
                }
              }
            }
          }
        }
      }
    },
