      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This week, distilled"
          }
        }
      }
    },
    "voice.whyThisPlan": {
      "comment": "voice. Plan rationale card; the argument is one sentence from the AI.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Why this plan: %@"
          }
        }
      }
    },
    "voice.workDone": {
      "comment": "voice. Workout finished; the second argument is total volume, e.g. 8,420 kg.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The work is done. %1$lld sets, %2$@ moved."
          }
        }
      }
    }
  },
  "version": "1.0"
}