    "plain.settings.ai.alwaysOn": {
      "comment": "plain. Explains why there's no switch for AI.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Transmute makes plans and weekly summaries with Apple Intelligence, so it can't be turned off here. Logging workouts works without it."
          }
        }
      }
    },
    "plain.settings.ai.cloudOff": {
      "comment": "plain. Footer when Private Cloud Compute is off.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off: everything is done on this device. Nothing you enter leaves it to make a plan."
          }
        }
      }
    },
    "plain.settings.ai.cloudOn": {
      "comment": "plain. Footer when Private Cloud Compute is on.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On: longer plans may be made on Private Cloud Compute, Apple's servers for Apple Intelligence. Transmute then sends what the plan is made from: your measurements, goal, schedule, equipment, limitations and recent training. Apple says these requests aren't stored and can't be read by Apple. It's free and needs no account."
          }
        }
      }
    },
